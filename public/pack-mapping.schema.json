{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obpal.blackboxes.net/pack-mapping.schema.json",
  "title": "mapping pack body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "site": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
    },
    "controller": {
      "enum": [
        "face.gamepad",
        "face.wheel",
        "face.wii",
        "face.mouse",
        "face.trackpad",
        "face.hand",
        "face.keyboard",
        "face.drums",
        "face.keys"
      ]
    },
    "buttons": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^(key:(#\\d{1,3}|[A-Za-z0-9]{1,32})|media:[a-z]{2,24}|pad:(raw:)?(b\\d{1,2}|a\\d{1,2}[+-])|back)$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(?:[a-z0-9.-]+|key-[A-Za-z0-9]+|tray:[a-zA-Z0-9._-]+|app:[a-z-]+)$"
      }
    },
    "controls": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "code"
            ],
            "properties": {
              "kind": {
                "const": "key"
              },
              "code": {
                "type": "string",
                "pattern": "^(Key[A-Z]|Digit[0-9]|Arrow(Up|Down|Left|Right)|Space|Enter|Escape|Tab|Backspace|Delete|Home|End|Page(Up|Down)|Shift(Left|Right)|Control(Left|Right)|Alt(Left|Right)|F([1-9]|1[0-2]))$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "button"
            ],
            "properties": {
              "kind": {
                "const": "mouse"
              },
              "button": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "button"
            ],
            "properties": {
              "kind": {
                "const": "gamepad"
              },
              "button": {
                "type": "integer",
                "minimum": 0,
                "maximum": 16
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "site",
    "controller",
    "controls"
  ]
}
