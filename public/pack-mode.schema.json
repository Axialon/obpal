{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obpal.blackboxes.net/pack-mode.schema.json",
  "title": "mode pack body",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "rig": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^<>\\r\\n]+$"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 30
    },
    "frames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 120,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "joints": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 64,
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9.-]{0,63}$"
            },
            "additionalProperties": {
              "type": "number"
            }
          }
        },
        "required": [
          "at",
          "joints"
        ]
      }
    }
  },
  "required": [
    "rig",
    "duration",
    "frames"
  ]
}
