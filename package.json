{
  "name": "ob-pal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Turn any phone into a remote for 3D and on-screen navigation: gyro, trackpad and button trays over WebRTC.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/sw/tsconfig.json && tsc -p worker/tsconfig.json && tsc -p extension/tsconfig.json",
    "build": "pnpm run typecheck && vite build",
    "build:extension": "pnpm --filter @obpal/extension run build",
    "build:packages": "node scripts/build-packages.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm run typecheck && vitest run",
    "check:live": "node scripts/check-live.mjs",
    "merge:lane": "node scripts/merge-lane.mjs",
    "deploy": "pnpm run test && pnpm run build && wrangler deploy",
    "sync:family": "node scripts/sync-family.mjs",
    "pack:extension": "pnpm run build:extension && pnpm --filter @obpal/extension run pack",
    "store:extension": "pnpm run build:extension && node extension/scripts/store.mjs",
    "store:art": "vite build && pnpm run build:extension && node extension/store/src/render.mjs",
    "e2e:all": "node scripts/e2e-all.mjs",
    "e2e:extension": "vite build && pnpm run build:extension && pnpm --filter @obpal/extension run e2e",
    "e2e:shared": "vite build && node scripts/e2e-shared.mjs",
    "e2e:sims": "vite build && node scripts/e2e-sims.mjs",
    "e2e:catalogue": "vite build && node scripts/e2e-catalogue.mjs",
    "perf:phone": "vite build && node scripts/perf-phone.mjs",
    "perf:connect": "vite build && node scripts/perf-connect.mjs",
    "oss:audit": "node scripts/oss-audit.mjs",
    "e2e:phone": "vite build && node scripts/e2e-phone.mjs",
    "e2e:home": "vite build && node scripts/e2e-home.mjs",
    "e2e:embed": "vite build && node scripts/e2e-embed.mjs",
    "e2e:code": "vite build && node scripts/e2e-code.mjs",
    "e2e:pages": "vite build && node scripts/e2e-pages.mjs",
    "fonts": "node scripts/fonts.mjs",
    "bench:extension": "vite build && pnpm run build:extension && node extension/scripts/bench.mjs",
    "icons": "node scripts/brand-icons.mjs"
  },
  "dependencies": {
    "@obpal/core": "workspace:*",
    "@obpal/host": "workspace:*",
    "camera-controls": "^3.1.2",
    "three": "^0.186.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.58.0",
    "@cloudflare/workers-types": "^5.20260924.1",
    "@types/three": "^0.186.0",
    "@zxing/library": "0.21.3",
    "clipper-lib": "6.4.2",
    "jsqr": "1.4.0",
    "opentype.js": "^1.3.4",
    "playwright": "1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  }
}
