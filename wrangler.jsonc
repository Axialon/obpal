// Self-host template: choose your Worker name, account and custom domain; see docs/SELF-HOSTING.md.
// Payments are disabled. Set your own address-hashing secret before deployment.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-29",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/r/*",
      "/sim/device/*",
      "/campaign/films/obpal-original-complete-web.mp4",
      "/campaign/films/obpal-one-thumb-eight-arms.mp4",
      "/campaign/films/obpal-make-a-mark.mp4",
      "/campaign/films/obpal-take-the-ring.mp4",
      "/campaign/films/obpal-screen-to-track.mp4",
      "/campaign/films/obpal-body-sets-the-rhythm.mp4"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room"
      },
      {
        "name": "CODES",
        "class_name": "Codes"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Room"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "Codes"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    }
  },
  "ratelimits": [
    {
      "name": "RL_SOCKET",
      "namespace_id": "1",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "RL_ICE",
      "namespace_id": "2",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    {
      "name": "RL_FILM",
      "namespace_id": "3",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "name": "my-controller",
  "workers_dev": false,
  "routes": [],
  "vars": {
    "STRIPE_SPONSORSHIP_ENABLED": "false",
    "GITHUB_SPONSORS_PENDING": "false"
  },
  "secrets": {
    "required": [
      "TURN_SECRET"
    ]
  }
}
